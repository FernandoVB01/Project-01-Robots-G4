<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Ground truth at the rear axle midpoint. The CAD base is midway between axles. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>rear_axle</robot_base_frame>
      <odom_topic>/model/challenger/ground_truth</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <xyz_offset>-0.150 0 -0.035</xyz_offset>
    </plugin>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <wheel_separation>0.190</wheel_separation>
      <kingpin_width>0.120</kingpin_width>
      <wheel_base>0.300</wheel_base>
      <wheel_radius>0.035</wheel_radius>
      <steering_limit>0.610865</steering_limit>
      <steer_p_gain>8.0</steer_p_gain>
      <topic>/model/challenger/cmd_vel</topic>
      <odom_topic>/model/challenger/wheel_odometry</odom_topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/model/challenger/joint_states</topic>
    </plugin>
  </gazebo>
  <xacro:macro name="tire_contact" params="link">
    <gazebo reference="${link}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:tire_contact link="rear_left_wheel_link_1"/>
  <xacro:tire_contact link="rear_right_wheel_link_1"/>
  <xacro:tire_contact link="front_left_wheel_link_1"/>
  <xacro:tire_contact link="front_right_wheel_link_1"/>
</robot>
